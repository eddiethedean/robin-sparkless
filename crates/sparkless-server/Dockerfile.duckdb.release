# The release workflow supplies the DuckDB product from its tested Linux wheel.
FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --chmod=755 sparkless-server-duckdb /usr/local/bin/sparkless-server-duckdb
COPY quack.duckdb_extension /usr/local/bin/quack.duckdb_extension
COPY NOTICE-quack.txt /usr/share/doc/sparkless-server-duckdb/NOTICE-quack.txt
EXPOSE 8099 15002
ENTRYPOINT ["/usr/local/bin/sparkless-server-duckdb", "serve", "--host", "0.0.0.0", "--port", "8099", "--connect-host", "0.0.0.0", "--connect-port", "15002"]
